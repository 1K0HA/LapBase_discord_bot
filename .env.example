# =========================
# Discord
# =========================
DISCORD_BOT_TOKEN=
# Разрешённые текстовые каналы Discord через запятую.
DISCORD_CHANNEL_IDS=111111111111111111,222222222222222222

# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=-1001234567890
# Главный администратор. Управляющие команды доступны только этому ID.
TELEGRAM_ADMIN_USER_ID=335707167
TELEGRAM_ADMIN_CHAT_ID=335707167
# Необязательный URL LapBaseApp.
LAPBASE_APP_URL=

# =========================
# Groq
# =========================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
GROQ_TIMEOUT_SECONDS=45

# =========================
# Supabase PostgreSQL
# Для IPv4 обычно используйте Session Pooler из Supabase Connect.
# =========================
SUPABASE_DB_URL=postgresql://postgres.project:password@host:5432/postgres
SUPABASE_BACKUP_DB_URL=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_SSL=true
DB_COMMAND_TIMEOUT_SECONDS=60

# =========================
# Сетевые таймауты
# =========================
TELEGRAM_TIMEOUT_SECONDS=30
DISCORD_API_TIMEOUT_SECONDS=30
DISCORD_READY_TIMEOUT_SECONDS=30

# =========================
# LapBase
# =========================
SYNC_HOURS=24
RETRY_DELAY_SECONDS=300
MAX_RETRIES=5
LOG_RETENTION_DAYS=3
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_COUNT=3
CLEANUP_INTERVAL_HOURS=48
TEMP_DATA_RETENTION_HOURS=48
SHOW_SOURCE_CHANNEL=true
